# Runtime filesystems, mount points, and filesystem internals.
/dev/
/proc/
/run/
/sys/
/tmp/
/cdrom/
/media/
/mnt/
/boot/lost+found/
/lost+found/
/swap.img

# HDD Storage handled separately.
#/srv/models/
#/var/backups/local/

# Volatile and rebuildable system state.
/var/crash/
/var/cache/
/var/lib/apt/lists/
/var/lib/snapd/cache/
/var/lib/systemd/coredump/
/var/tmp/

# User trash, caches, and generated application state.
**/.Trash-[0-9]*/
